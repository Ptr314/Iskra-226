10 REM РОЗЕТКА НА ГРАФОПОСТРОИТЕЛЕ
20 DIM B¤(60)253
30 SELECT R
40 PRINT HEX(03)
50 PRINT "ЧЕРЧУ РОЗЕТКУ НА ГРАФОПОСТРОИТЕЛЕ..."
60 ¤OPEN B¤()
70 WINDOW 0,559,0,255
80 FRAME B¤(),0,559,0,255
90 REM РАМКА ЛИСТА
100 NPLOT B¤(),4,4:DRAW B¤(),555,4:DRAW B¤(),555,251
110 DRAW B¤(),4,251:DRAW B¤(),4,4
120 REM РОЗЕТКА R=110*COS(3T)
130 X0=280:Y0=124
140 FOR T=0 TO 6.29 STEP .02
150 R=108*COS(3*T)
160 X=X0+R*COS(T)*1.7
170 Y=Y0+R*SIN(T)
180 IF T>0 THEN 210
190 NPLOT B¤(),X,Y
200 GOTO 220
210 DRAW B¤(),X,Y
220 NEXT T
230 NPLOT B¤(),18,238:LABEL B¤(),,,"РОЗЕТКА  R=108*COS(3T)"
240 ¤COPY /14,B¤()
250 PRINT "ГОТОВО. СМОТРИТЕ ЛИСТ ГРАФОПОСТРОИТЕЛЯ."
260 END
