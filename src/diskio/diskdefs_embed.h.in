// Сгенерировано на этапе configure из libs/dsk_tools/src/diskdefs. Не править.
//
// dsk_tools отдаёт геометрии CP/M и FAT текстовым файлом. В DISK Commander он
// приходит ресурсом Qt; здесь Qt нет, поэтому вшиваем содержимое в код.

#pragma once

#include <string>

namespace dsk_tools {

    inline const std::string & embedded_diskdefs()
    {
        static const std::string contents = R"DSKDEFS(@DISKDEFS_CONTENTS@)DSKDEFS";
        return contents;
    }

} // namespace dsk_tools